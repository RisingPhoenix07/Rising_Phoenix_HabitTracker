generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Segment {
  id        String   @id @default(uuid())
  userId    String   @default("legacy_user") // <-- Assigns default value
  name      String
  order     Int
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Task {
  id        String     @id @default(uuid())
  userId    String     @default("legacy_user") // <-- Assigns default value
  segmentId String
  segment   Segment    @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  logs      DailyLog[]
  createdAt DateTime   @default(now())
}

model DailyLog {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date      DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  userId    String   @default("legacy_user") // <-- Assigns default value
  date      DateTime
  content   String
  createdAt DateTime @default(now())
}


model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}